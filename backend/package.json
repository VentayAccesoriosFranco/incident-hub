{
  "name": "incident-hub-backend",
  "version": "0.1.0",
  "private": true,
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "build": "node --check src/app.js && node --check src/server.js",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage"
  },
  
  "jest": {
  "collectCoverageFrom": ["src/**/*.js", "!src/server.js"],
  "coverageThreshold": {
    "global": {
      "statements": 70,
      "branches": 50,
      "functions": 70,
      "lines": 70
    }
  }
},
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  }
}